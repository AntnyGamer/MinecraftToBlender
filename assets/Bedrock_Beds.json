            "color = bedColor == 14 && thisBlock.name == 'minecraft:bed' ? 'red' : color",
            "color = bedColor == 15 && thisBlock.name == 'minecraft:bed' ? 'black' : color",
            "part = thisBlock.state.head_piece_bit == 0 ? 'foot' : part",
            "part = thisBlock.state.head_piece_bit == 1 ? 'head' : part",
            "rotY = thisBlock.state.direction == 0 ? 180.0 : rotY",

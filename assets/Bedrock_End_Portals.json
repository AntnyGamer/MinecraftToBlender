{
    "blocks": ["minecraft:end_portal", "minecraft:end_gateway"],
    "defaultTexture": "minecraft:block/end_portal",
    "handler": {
        "textures": {"texture": "'minecraft:block/end_portal'"},
        "children": [
            {
                "condition": "thisBlock.name == 'minecraft:end_portal'",
                "elements": [{
                    "from": [0, 12, 0], "to": [16, 12, 16],
                    "texture": "'#texture'", "faces": {"up": {}}
                }]
            },
            {
                "condition": "thisBlock.name == 'minecraft:end_gateway'",
                "elements": [{
                    "from": [0, 0, 0], "to": [16, 16, 16],
                    "texture": "'#texture'"
                }]
            }
        ]
    }
}

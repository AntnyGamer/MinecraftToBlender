{
    "blocks": [
        "minecraft:frame",
        "minecraft:glow_frame"
    ],
    "handler": {
        "transform": {"translate": [8, 0, 8]},
        "generators": [
            {
                "type": "entity",
                "args": {
                    "id": "thisBlock.name == 'minecraft:glow_frame' ? 'minecraft:glow_item_frame' : 'minecraft:item_frame'",
                    "properties": "thisBlock.state"
                }
            }
        ]
    }
}
